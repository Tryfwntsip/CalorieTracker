# Copy to .env and fill in. NEVER commit .env (gitignored).
# Only EXPO_PUBLIC_* variables may exist here — they are bundled into the app.
# Provider secrets (USDA key, AI vision key) live ONLY in Supabase Edge
# Function secrets (`supabase secrets set`), never in this file.

# Supabase project (needed from Milestone 2 onward; app runs without it in M1)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
